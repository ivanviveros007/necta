{
  "name": "@necta/api",
  "version": "0.1.0",
  "private": true,
  "description": "API NestJS de Necta \u00b7 Caja a 14 d\u00edas",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=.env --enable-source-maps dist/src/main.js",
    "dev": "npm run build && npm run start",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --experimental-vm-modules ../../node_modules/jest/bin/jest.js --runInBand",
    "seed": "node --env-file-if-exists=.env dist/src/scripts/seed.js",
    "reset": "node --env-file-if-exists=.env dist/src/scripts/seed.js --reset"
  },
  "devDependencies": {
    "@nestjs/testing": "^12.1.3",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.20.5",
    "@types/supertest": "^7.2.1",
    "jest": "^30.5.2",
    "socket.io-client": "^4.8.4",
    "supertest": "^7.3.1",
    "ts-jest": "^29.4.15"
  },
  "dependencies": {
    "@necta/cash-engine": "^0.1.0",
    "@necta/contracts": "^0.1.0",
    "@nestjs/common": "^12.1.3",
    "@nestjs/core": "^12.1.3",
    "@nestjs/jwt": "^12.0.3",
    "@nestjs/mongoose": "^12.0.0",
    "@nestjs/platform-express": "^12.1.3",
    "@nestjs/platform-socket.io": "^12.1.3",
    "@nestjs/schedule": "^12.0.2",
    "@nestjs/websockets": "^12.1.3",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "mongoose": "^9.11.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "socket.io": "^4.8.4",
    "zod": "^4.6.7"
  }
}
