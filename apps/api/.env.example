# Copiar a .env (no versionado). Valores de ejemplo, sin credenciales reales.
NODE_ENV=development
PORT=3000
MONGO_URI=mongodb://127.0.0.1:27018/?directConnection=true&replicaSet=rs0
MONGO_DB=necta_demo
# Mínimo 32 caracteres; obligatorio en producción
JWT_SECRET=cambia-este-secreto-local-de-al-menos-32-caracteres
JWT_TTL_SECONDS=28800
WEB_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
COOKIE_SECURE=false
# Reproduce el caso: lunes 25 de mayo de 2026 con corte al inicio del día
BUSINESS_DATE=2026-05-25
TODAY_POLICY=fullDay
REVIEW_BATCH_MS=30000
DAILY_REVIEW_HOUR=7
SCHEDULER_ENABLED=true
DEV_ENDPOINTS=true
