{
  "name": "necta",
  "private": true,
  "version": "0.1.0",
  "description": "Necta \u00b7 Caja a 14 d\u00edas (API NestJS, web React/Vite, m\u00f3vil Expo)",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build:packages": "npm run build -w @necta/contracts -w @necta/cash-engine",
    "openspec:validate": "OPENSPEC_TELEMETRY=0 openspec validate caja-a-14-dias --strict",
    "mongo:start": "node scripts/mongo.mjs start",
    "mongo:status": "node scripts/mongo.mjs status",
    "mongo:stop": "node scripts/mongo.mjs stop",
    "build:api": "npm run build:packages && npm run build -w @necta/api",
    "seed": "npm run seed -w @necta/api",
    "dev:api": "npm run start -w @necta/api",
    "dev:web": "npm run dev -w @necta/web",
    "dev:mobile": "npm run start -w @necta/mobile",
    "typecheck": "npm run typecheck -w @necta/cash-engine -w @necta/contracts -w @necta/api -w @necta/web -w @necta/mobile",
    "test": "npm test -w @necta/cash-engine -w @necta/contracts -w @necta/api -w @necta/web",
    "bench": "npm run build -w @necta/cash-engine && node packages/cash-engine/scripts/bench.mjs"
  },
  "devDependencies": {
    "@fission-ai/openspec": "^1.14.2",
    "typescript": "~6.0.3"
  },
  "overrides": {
    "react": "19.3.0",
    "react-dom": "19.3.0"
  }
}
